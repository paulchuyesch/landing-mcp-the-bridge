# Brevo API Key - Obtener en https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_api_key_here

# ID de la lista de contactos en Brevo (opcional, por defecto: 2)
BREVO_LIST_ID=2

# Waitlist abuse gate local antes de llamar a Brevo
WAITLIST_RATE_LIMIT_MAX=3
WAITLIST_RATE_LIMIT_WINDOW_MS=3600000
