# Brevo API Key - Obtener en https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_api_key_here

# Origen público autorizado para POST /api/scan.
# Actualízalo al conectar un dominio propio.
SCAN_ALLOWED_ORIGIN=https://landing-mcp-the-bridge.vercel.app

# ID de la lista de contactos en Brevo (opcional, por defecto: 2)
BREVO_LIST_ID=2

# Waitlist abuse gate local antes de llamar a Brevo
WAITLIST_RATE_LIMIT_WINDOW_MS=3600000
WAITLIST_RATE_LIMIT_EMAIL_MAX=3
WAITLIST_RATE_LIMIT_IP_MAX=10
WAITLIST_RATE_LIMIT_GLOBAL_MAX=100

# Por defecto no se confia en headers forwardeados para evitar spoofing directo.
# Habilitar solo si el despliegue esta detras de un proxy/CDN confiable.
WAITLIST_TRUST_PROXY=false
WAITLIST_CLIENT_IP_HEADER=cf-connecting-ip
