---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/sections/Navbar';
import { Footer } from '../../components/sections/Footer';
import { AeoScannerWidget } from "../../components/scanner/AeoScannerWidget";

export const prerender = true;
---

<Layout
  title="MCP Bridge | Descubre si la IA encuentra tu tienda"
  description="Analiza gratis tu e-commerce en segundos y descubre qué está impidiendo que la IA encuentre, entienda y recomiende tus productos."
>
  <Navbar client:idle />

  <main class="min-h-screen pt-24 pb-16 section-grid-dot">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <AeoScannerWidget client:load />

    </div>
  </main>

  <Footer />
</Layout>
