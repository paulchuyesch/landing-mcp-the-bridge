---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/sections/Navbar';
import { Hero } from '../components/sections/Hero';
import Features from '../components/sections/Features.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import MarketShift from '../components/sections/MarketShift.astro';
import BridgeSolution from '../components/sections/BridgeSolution.astro';
import BridgeSolutionAccordion from '../components/sections/BridgeSolutionAccordion.astro';
import AudiencePaths from '../components/sections/AudiencePaths.astro';
import FinalCall from '../components/sections/FinalCall.astro';
import { CTA } from '../components/sections/CTA';
import { Footer } from '../components/sections/Footer';

const USE_ACCORDION_SOLUTION_PREVIEW = true;
---

<Layout title="THE BRIDGE - Protocolo Universal para IA & E-commerce">
  <Navbar client:idle />
  <main>
    <Hero client:load />
    <Features />
    <section class="border-y border-border bg-background-secondary py-12">
      <div class="container mx-auto px-6 text-center">
        <p class="text-foreground-muted mb-4">¿Tu tienda está lista para ser entendida por agentes de IA?</p>
        <a href="/scan" class="btn-primary inline-flex">Analizar mi tienda gratis</a>
      </div>
    </section>
    <HowItWorks />
    {USE_ACCORDION_SOLUTION_PREVIEW ? <BridgeSolutionAccordion /> : <BridgeSolution />}
    <FinalCall />
    <AudiencePaths />
    <MarketShift />
    <CTA client:visible />
  </main>
  <Footer />
</Layout>
