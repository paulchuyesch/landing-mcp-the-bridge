---
const features = [
  {
    label: "DESCUBRIMIENTO",
    title: "Discovery Beacon",
    content: "Faro de autodescubrimiento para que la IA\nlea tu catálogo de forma pasiva y segura",
  },
  {
    label: "SINCRONIZACIÓN",
    title: "Sincronización en Vivo",
    content: "Actualizaciones instantáneas de precios\ny stock sin retrasos ni consultas lentas",
  },
  {
    label: "SEGURIDAD",
    title: "Protección Anti-Scraping",
    content: "Filtra y bloquea consultas abusivas\nde bots externos, protegiendo tu servidor",
  },
  {
    label: "INTEGRACIÓN",
    title: "Modelos de IA & Agentes",
    content: "Compatible con los principales asistentes y LLMs\ndel mercado (Gemini, Claude, OpenAI)",
  },
  {
    label: "RENDIMIENTO",
    title: "Alta Escalabilidad",
    content: "Soporte para miles de productos y consultas\nsimultáneas sin ralentizar tu tienda WordPress",
  },
  {
    label: "ECOSISTEMA",
    title: "Open Source",
    content: "Ecosistema transparente para WooCommerce,\ncompletamente auditable y seguro",
  },
];
---

<section id="features" class="border-t border-border">
  <div class="grid grid-cols-2 lg:grid-cols-4">
    <!-- Header cell - larger -->
    <div
      class="relative z-10 overflow-hidden animate-on-scroll animate-on-scroll-fade col-span-2 lg:col-span-1 lg:row-span-2 border-b border-r border-border p-8 lg:p-10 flex flex-col justify-center"
    >
      <!-- Decoración de Puente Abstracto -->
      <div class="absolute inset-0 pointer-events-none -z-10 opacity-30">
        <svg class="absolute w-full h-full" viewBox="0 0 200 200" preserveAspectRatio="none">
          <!-- Poste principal -->
          <path d="M156 30 L164 30 L162 200 L158 200 Z" fill="currentColor" class="text-foreground-subtle/20" />
          <rect x="157" y="20" width="6" height="10" fill="currentColor" class="text-foreground-subtle/30" />
          
          <!-- Cable principal izquierdo -->
          <path d="M0 -20 Q 80 160 160 30" fill="none" stroke="currentColor" stroke-width="2" class="text-orange-500/40" />
          
          <!-- Cable principal derecho -->
          <path d="M160 30 Q 180 80 200 120" fill="none" stroke="currentColor" stroke-width="2" class="text-orange-500/40" />

          <!-- Cuerdas tensoras izquierdas -->
          <line x1="20" y1="21" x2="20" y2="200" stroke="currentColor" stroke-width="0.5" class="text-foreground-muted/30" />
          <line x1="40" y1="55" x2="40" y2="200" stroke="currentColor" stroke-width="0.5" class="text-foreground-muted/30" />
          <line x1="60" y1="86" x2="60" y2="200" stroke="currentColor" stroke-width="0.5" class="text-foreground-muted/30" />
          <line x1="80" y1="109" x2="80" y2="200" stroke="currentColor" stroke-width="0.5" class="text-foreground-muted/30" />
          <line x1="100" y1="123" x2="100" y2="200" stroke="currentColor" stroke-width="0.5" class="text-foreground-muted/30" />
          <line x1="120" y1="122" x2="120" y2="200" stroke="currentColor" stroke-width="0.5" class="text-foreground-muted/30" />
          <line x1="140" y1="95" x2="140" y2="200" stroke="currentColor" stroke-width="0.5" class="text-foreground-muted/30" />

          <!-- Cuerdas tensoras derechas -->
          <line x1="180" y1="67" x2="180" y2="200" stroke="currentColor" stroke-width="0.5" class="text-foreground-muted/30" />
        </svg>
      </div>

      <p class="type-micro text-xs text-foreground-subtle uppercase tracking-wider mb-3">Capacidades</p>
      <h2 class="flex flex-col">
        <span class="text-5xl md:text-6xl lg:text-7xl font-medium text-foreground-subtle leading-none tracking-tight -mb-2">El</span>
        <span class="text-6xl md:text-7xl lg:text-8xl font-black text-orange-500 leading-none tracking-tighter">puente</span>
      </h2>
    </div>

    {features.map((feature, index) => (
      <div
        class={`animate-on-scroll delay-${index + 1} border-b border-r border-border p-6 lg:p-8`}
      >
        <p class="type-micro text-xs text-foreground-subtle uppercase tracking-wider mb-3">{feature.label}</p>
        <h3 class="text-h4 text-foreground mb-2">{feature.title}</h3>
        <p class="text-body text-foreground-subtle whitespace-pre-line">{feature.content}</p>
      </div>
    ))}
  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll('#features .animate-on-scroll, #features .animate-on-scroll-fade').forEach((el) => {
    observer.observe(el);
  });
</script>
