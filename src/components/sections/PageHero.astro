---
interface CTA {
  href: string;
  label: string;
  tone?: 'primary' | 'secondary';
}

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  ctas?: CTA[];
}

const { eyebrow, title, description, ctas = [] } = Astro.props;
---

<section class="border-b border-border bg-background section-grid-dot">
  <div class="container relative z-10 mx-auto px-6 py-14 md:py-18 lg:py-24">
    {eyebrow && (
      <p class="type-micro text-xs uppercase tracking-[0.16em] text-foreground-subtle mb-5">{eyebrow}</p>
    )}
    <h1 class="max-w-5xl text-h1">
      {title}
    </h1>
    <p class="mt-6 max-w-3xl text-body-lead text-foreground-muted">
      {description}
    </p>

    {ctas.length > 0 && (
      <div class="mt-8 flex flex-col sm:flex-row gap-4">
        {ctas.map((cta) => (
          <a
            href={cta.href}
            class:list={[
              "h-12 px-7 text-sm font-semibold inline-flex items-center justify-center",
              cta.tone === 'secondary'
                ? "btn-secondary"
                : "btn-primary",
            ]}
          >
            {cta.label}
          </a>
        ))}
      </div>
    )}
  </div>
</section>
